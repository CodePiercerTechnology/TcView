{
    "name": "IEC ST",
    "scopeName": "source.iec-st",
    "fileTypes": [".st", ".TcPOU", ".TcGVL", ".TcDUT", ".TcPRG", ".TcAPP", ".TcCOM", ".TcVAR"],
    "patterns": [
        {
            "include": "#preprocessor"
        },
        {
            "include": "#comments"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#time-literals"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#operators"
        },
        {
            "include": "#function-blocks"
        },
        {
            "include": "#functions"
        },
        {
            "include": "#types"
        },
        {
            "include": "#constants"
        },
        {
            "include": "#variables"
        }
    ],
    "repository": {
        "preprocessor": {
            "patterns": [
                {
                    "match": "\\{attribute\\s+'[^']*'\\}",
                    "name": "meta.preprocessor.iec-st"
                },
                {
                    "match": "\\{region\\}",
                    "name": "meta.preprocessor.iec-st"
                },
                {
                    "match": "\\{endregion\\}",
                    "name": "meta.preprocessor.iec-st"
                }
            ]
        },
        "comments": {
            "patterns": [
                {
                    "begin": "\\(\\*",
                    "end": "\\*\\)",
                    "name": "comment.block.iec-st"
                },
                {
                    "begin": "/\\*",
                    "end": "\\*/",
                    "name": "comment.block.iec-st"
                },
                {
                    "match": "//.*$",
                    "name": "comment.line.double-slash.iec-st"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "begin": "'",
                    "end": "'",
                    "name": "string.quoted.single.iec-st",
                    "patterns": [
                        {
                            "match": "''",
                            "name": "constant.character.escape.iec-st"
                        }
                    ]
                },
                {
                    "begin": "\"",
                    "end": "\"",
                    "name": "string.quoted.double.iec-st"
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "match": "\\b2#[01]+(_[01]+)*\\b",
                    "name": "constant.numeric.binary.iec-st"
                },
                {
                    "match": "\\b8#[0-7]+(_[0-7]+)*\\b",
                    "name": "constant.numeric.octal.iec-st"
                },
                {
                    "match": "\\b16#[0-9A-Fa-f]+(_[0-9A-Fa-f]+)*\\b",
                    "name": "constant.numeric.hex.iec-st"
                },
                {
                    "match": "\\b\\d+(_\\d+)*\\.\\d+(_\\d+)*([eE][+-]?\\d+(_\\d+)*)?\\b",
                    "name": "constant.numeric.real.iec-st"
                },
                {
                    "match": "\\b\\d+(_\\d+)*\\b",
                    "name": "constant.numeric.integer.iec-st"
                }
            ]
        },
        "time-literals": {
            "patterns": [
                {
                    "match": "\\b(T|TIME)#[0-9]+(_[0-9]+)*(ms|s|m|h|d|MS|S|M|H|D)\\b",
                    "name": "constant.other.time.iec-st"
                },
                {
                    "match": "\\b(T|TIME)#[0-9]+(_[0-9]+)*\\b",
                    "name": "constant.other.time.iec-st"
                },
                {
                    "match": "\\b(DT|DATE_AND_TIME)#[0-9]+-[0-9]+-[0-9]+-[0-9]+:[0-9]+:[0-9]+\\b",
                    "name": "constant.other.datetime.iec-st"
                },
                {
                    "match": "\\b(D|DATE)#[0-9]+-[0-9]+-[0-9]+\\b",
                    "name": "constant.other.date.iec-st"
                },
                {
                    "match": "\\b(TOD|TIME_OF_DAY)#[0-9]+:[0-9]+:[0-9]+(\\.[0-9]+)?\\b",
                    "name": "constant.other.timeofday.iec-st"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "match": "\\b(PROGRAM|END_PROGRAM|FUNCTION|END_FUNCTION|FUNCTION_BLOCK|END_FUNCTION_BLOCK|INTERFACE|END_INTERFACE|METHOD|END_METHOD|PROPERTY|END_PROPERTY|ACTION|END_ACTION|TRANSITION|END_TRANSITION|STEP|END_STEP|INITIAL_STEP)\\b",
                    "name": "keyword.control.block.iec-st"
                },
                {
                    "match": "\\b(VAR|END_VAR|VAR_INPUT|VAR_OUTPUT|VAR_IN_OUT|VAR_TEMP|VAR_EXTERNAL|VAR_GLOBAL|VAR_ACCESS|VAR_CONFIG|VAR_STAT|VAR_RETAIN|VAR_CONSTANT|VAR_INST|PERSISTENT|RETAIN)\\b",
                    "name": "keyword.control.variable.iec-st"
                },
                {
                    "match": "\\b(IF|THEN|ELSE|ELSIF|END_IF|CASE|OF|END_CASE|FOR|TO|BY|DO|END_FOR|WHILE|END_WHILE|REPEAT|UNTIL|END_REPEAT|EXIT|RETURN|CONTINUE|GOTO|LABEL|JMP|JMPC|JMPCN|RET|RETC|RETCN|CAL|CALC|CALCN|PARAMS)\\b",
                    "name": "keyword.control.flow.iec-st"
                },
                {
                    "match": "\\b(AT|CONSTANT|READ_ONLY|READ_WRITE|WRITE_PROTECTED|RETAIN|NON_RETAIN|VOLATILE|EXTERNAL|PUBLIC|PRIVATE|PROTECTED|INTERNAL|FINAL|ABSTRACT|EXTENDS|IMPLEMENTS|OVERRIDE|THIS|SUPER|REF|_SYSTEM|__SYSTEM)\\b",
                    "name": "keyword.other.modifier.iec-st"
                },
                {
                    "match": "\\b(NOT|AND|ANDN|OR|ORN|XOR|XORN|MOD|DIV|SHL|SHR|ROL|ROR|LD|LDN|ST|STN|S|R)\\b",
                    "name": "keyword.operator.logical.iec-st"
                },
                {
                    "match": "\\b(BOOL#|BYTE#|WORD#|DWORD#|LWORD#|SINT#|INT#|DINT#|LINT#|USINT#|UINT#|UDINT#|ULINT#|REAL#|LREAL#)\\b",
                    "name": "keyword.operator.type-cast.iec-st"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "match": ":=",
                    "name": "keyword.operator.assignment.iec-st"
                },
                {
                    "match": "=>",
                    "name": "keyword.operator.output.iec-st"
                },
                {
                    "match": "\\*\\*",
                    "name": "keyword.operator.power.iec-st"
                },
                {
                    "match": "<>",
                    "name": "keyword.operator.not-equal.iec-st"
                },
                {
                    "match": "<=",
                    "name": "keyword.operator.less-equal.iec-st"
                },
                {
                    "match": ">=",
                    "name": "keyword.operator.greater-equal.iec-st"
                },
                {
                    "match": "[+\\-*/]",
                    "name": "keyword.operator.arithmetic.iec-st"
                },
                {
                    "match": "[=<>]",
                    "name": "keyword.operator.comparison.iec-st"
                }
            ]
        },
        "function-blocks": {
            "patterns": [
                {
                    "match": "\\b(TOF|TON|TP|R_TRIG|F_TRIG|RS|SR|CTU|CTD|CTUD|SEMA|FIFO|LIFO|STACK)\\b",
                    "name": "support.class.function-block.iec-st"
                }
            ]
        },
        "functions": {
            "patterns": [
                {
                    "match": "\\b(ABS|SQRT|LN|LOG|EXP|SIN|COS|TAN|ASIN|ACOS|ATAN|ATAN2|EXPT|LEN|LEFT|RIGHT|MID|CONCAT|INSERT|DELETE|REPLACE|FIND|LIMIT|SEL|MAX|MIN|MUX|ADR|ADRINST|SIZEOF|BITADR|IS_VALID_REF|MOVE|SHL|SHR|ROL|ROR|ROR|ADD|SUB|MUL|DIV|MOD|GE|LE|GT|LT|EQ|NE|AND|OR|XOR|NOT|INDEXOF|SIZEOF|LOWER_BOUND|UPPER_BOUND)\\b",
                    "name": "support.function.builtin.iec-st"
                },
                {
                    "match": "\\b(BOOL_TO_BYTE|BOOL_TO_WORD|BOOL_TO_DWORD|BOOL_TO_LWORD|BOOL_TO_SINT|BOOL_TO_INT|BOOL_TO_DINT|BOOL_TO_LINT|BOOL_TO_USINT|BOOL_TO_UINT|BOOL_TO_UDINT|BOOL_TO_ULINT|BOOL_TO_REAL|BOOL_TO_LREAL|BOOL_TO_STRING|BOOL_TO_WSTRING|BOOL_TO_TIME|BOOL_TO_DATE|BOOL_TO_TOD|BOOL_TO_DT|BYTE_TO_BOOL|BYTE_TO_WORD|BYTE_TO_DWORD|BYTE_TO_LWORD|BYTE_TO_SINT|BYTE_TO_INT|BYTE_TO_DINT|BYTE_TO_LINT|BYTE_TO_USINT|BYTE_TO_UINT|BYTE_TO_UDINT|BYTE_TO_ULINT|BYTE_TO_REAL|BYTE_TO_LREAL|BYTE_TO_STRING|BYTE_TO_WSTRING|BYTE_TO_TIME|BYTE_TO_DATE|BYTE_TO_TOD|BYTE_TO_DT|WORD_TO_BOOL|WORD_TO_BYTE|WORD_TO_DWORD|WORD_TO_LWORD|WORD_TO_SINT|WORD_TO_INT|WORD_TO_DINT|WORD_TO_LINT|WORD_TO_USINT|WORD_TO_UINT|WORD_TO_UDINT|WORD_TO_ULINT|WORD_TO_REAL|WORD_TO_LREAL|WORD_TO_STRING|WORD_TO_WSTRING|WORD_TO_TIME|WORD_TO_DATE|WORD_TO_TOD|WORD_TO_DT|DWORD_TO_BOOL|DWORD_TO_BYTE|DWORD_TO_WORD|DWORD_TO_LWORD|DWORD_TO_SINT|DWORD_TO_INT|DWORD_TO_DINT|DWORD_TO_LINT|DWORD_TO_USINT|DWORD_TO_UINT|DWORD_TO_UDINT|DWORD_TO_ULINT|DWORD_TO_REAL|DWORD_TO_LREAL|DWORD_TO_STRING|DWORD_TO_WSTRING|DWORD_TO_TIME|DWORD_TO_DATE|DWORD_TO_TOD|DWORD_TO_DT|LWORD_TO_BOOL|LWORD_TO_BYTE|LWORD_TO_WORD|LWORD_TO_DWORD|LWORD_TO_SINT|LWORD_TO_INT|LWORD_TO_DINT|LWORD_TO_LINT|LWORD_TO_USINT|LWORD_TO_UINT|LWORD_TO_UDINT|LWORD_TO_ULINT|LWORD_TO_REAL|LWORD_TO_LREAL|LWORD_TO_STRING|LWORD_TO_WSTRING|LWORD_TO_TIME|LWORD_TO_DATE|LWORD_TO_TOD|LWORD_TO_DT|SINT_TO_BOOL|SINT_TO_BYTE|SINT_TO_WORD|SINT_TO_DWORD|SINT_TO_LWORD|SINT_TO_INT|SINT_TO_DINT|SINT_TO_LINT|SINT_TO_USINT|SINT_TO_UINT|SINT_TO_UDINT|SINT_TO_ULINT|SINT_TO_REAL|SINT_TO_LREAL|SINT_TO_STRING|SINT_TO_WSTRING|SINT_TO_TIME|SINT_TO_DATE|SINT_TO_TOD|SINT_TO_DT|INT_TO_BOOL|INT_TO_BYTE|INT_TO_WORD|INT_TO_DWORD|INT_TO_LWORD|INT_TO_SINT|INT_TO_DINT|INT_TO_LINT|INT_TO_USINT|INT_TO_UINT|INT_TO_UDINT|INT_TO_ULINT|INT_TO_REAL|INT_TO_LREAL|INT_TO_STRING|INT_TO_WSTRING|INT_TO_TIME|INT_TO_DATE|INT_TO_TOD|INT_TO_DT|DINT_TO_BOOL|DINT_TO_BYTE|DINT_TO_WORD|DINT_TO_DWORD|DINT_TO_LWORD|DINT_TO_SINT|DINT_TO_INT|DINT_TO_LINT|DINT_TO_USINT|DINT_TO_UINT|DINT_TO_UDINT|DINT_TO_ULINT|DINT_TO_REAL|DINT_TO_LREAL|DINT_TO_STRING|DINT_TO_WSTRING|DINT_TO_TIME|DINT_TO_DATE|DINT_TO_TOD|DINT_TO_DT|LINT_TO_BOOL|LINT_TO_BYTE|LINT_TO_WORD|LINT_TO_DWORD|LINT_TO_LWORD|LINT_TO_SINT|LINT_TO_INT|LINT_TO_DINT|LINT_TO_USINT|LINT_TO_UINT|LINT_TO_UDINT|LINT_TO_ULINT|LINT_TO_REAL|LINT_TO_LREAL|LINT_TO_STRING|LINT_TO_WSTRING|LINT_TO_TIME|LINT_TO_DATE|LINT_TO_TOD|LINT_TO_DT|USINT_TO_BOOL|USINT_TO_BYTE|USINT_TO_WORD|USINT_TO_DWORD|USINT_TO_LWORD|USINT_TO_SINT|USINT_TO_INT|USINT_TO_DINT|USINT_TO_LINT|USINT_TO_UINT|USINT_TO_UDINT|USINT_TO_ULINT|USINT_TO_REAL|USINT_TO_LREAL|USINT_TO_STRING|USINT_TO_WSTRING|USINT_TO_TIME|USINT_TO_DATE|USINT_TO_TOD|USINT_TO_DT|UINT_TO_BOOL|UINT_TO_BYTE|UINT_TO_WORD|UINT_TO_DWORD|UINT_TO_LWORD|UINT_TO_SINT|UINT_TO_INT|UINT_TO_DINT|UINT_TO_LINT|UINT_TO_USINT|UINT_TO_UDINT|UINT_TO_ULINT|UINT_TO_REAL|UINT_TO_LREAL|UINT_TO_STRING|UINT_TO_WSTRING|UINT_TO_TIME|UINT_TO_DATE|UINT_TO_TOD|UINT_TO_DT|UDINT_TO_BOOL|UDINT_TO_BYTE|UDINT_TO_WORD|UDINT_TO_DWORD|UDINT_TO_LWORD|UDINT_TO_SINT|UDINT_TO_INT|UDINT_TO_DINT|UDINT_TO_LINT|UDINT_TO_USINT|UDINT_TO_UINT|UDINT_TO_ULINT|UDINT_TO_REAL|UDINT_TO_LREAL|UDINT_TO_STRING|UDINT_TO_WSTRING|UDINT_TO_TIME|UDINT_TO_DATE|UDINT_TO_TOD|UDINT_TO_DT|ULINT_TO_BOOL|ULINT_TO_BYTE|ULINT_TO_WORD|ULINT_TO_DWORD|ULINT_TO_LWORD|ULINT_TO_SINT|ULINT_TO_INT|ULINT_TO_DINT|ULINT_TO_LINT|ULINT_TO_USINT|ULINT_TO_UINT|ULINT_TO_UDINT|ULINT_TO_REAL|ULINT_TO_LREAL|ULINT_TO_STRING|ULINT_TO_WSTRING|ULINT_TO_TIME|ULINT_TO_DATE|ULINT_TO_TOD|ULINT_TO_DT|REAL_TO_BOOL|REAL_TO_BYTE|REAL_TO_WORD|REAL_TO_DWORD|REAL_TO_LWORD|REAL_TO_SINT|REAL_TO_INT|REAL_TO_DINT|REAL_TO_LINT|REAL_TO_USINT|REAL_TO_UINT|REAL_TO_UDINT|REAL_TO_ULINT|REAL_TO_LREAL|REAL_TO_STRING|REAL_TO_WSTRING|REAL_TO_TIME|REAL_TO_DATE|REAL_TO_TOD|REAL_TO_DT|LREAL_TO_BOOL|LREAL_TO_BYTE|LREAL_TO_WORD|LREAL_TO_DWORD|LREAL_TO_LWORD|LREAL_TO_SINT|LREAL_TO_INT|LREAL_TO_DINT|LREAL_TO_LINT|LREAL_TO_USINT|LREAL_TO_UINT|LREAL_TO_UDINT|LREAL_TO_ULINT|LREAL_TO_REAL|LREAL_TO_STRING|LREAL_TO_WSTRING|LREAL_TO_TIME|LREAL_TO_DATE|LREAL_TO_TOD|LREAL_TO_DT|TIME_TO_BOOL|TIME_TO_BYTE|TIME_TO_WORD|TIME_TO_DWORD|TIME_TO_LWORD|TIME_TO_SINT|TIME_TO_INT|TIME_TO_DINT|TIME_TO_LINT|TIME_TO_USINT|TIME_TO_UINT|TIME_TO_UDINT|TIME_TO_ULINT|TIME_TO_REAL|TIME_TO_LREAL|TIME_TO_STRING|TIME_TO_WSTRING|TIME_TO_DATE|TIME_TO_TOD|TIME_TO_DT|DATE_TO_BOOL|DATE_TO_BYTE|DATE_TO_WORD|DATE_TO_DWORD|DATE_TO_LWORD|DATE_TO_SINT|DATE_TO_INT|DATE_TO_DINT|DATE_TO_LINT|DATE_TO_USINT|DATE_TO_UINT|DATE_TO_UDINT|DATE_TO_ULINT|DATE_TO_REAL|DATE_TO_LREAL|DATE_TO_STRING|DATE_TO_WSTRING|DATE_TO_TIME|DATE_TO_TOD|DATE_TO_DT|TOD_TO_BOOL|TOD_TO_BYTE|TOD_TO_WORD|TOD_TO_DWORD|TOD_TO_LWORD|TOD_TO_SINT|TOD_TO_INT|TOD_TO_DINT|TOD_TO_LINT|TOD_TO_USINT|TOD_TO_UINT|TOD_TO_UDINT|TOD_TO_ULINT|TOD_TO_REAL|TOD_TO_LREAL|TOD_TO_STRING|TOD_TO_WSTRING|TOD_TO_TIME|TOD_TO_DATE|TOD_TO_DT|DT_TO_BOOL|DT_TO_BYTE|DT_TO_WORD|DT_TO_DWORD|DT_TO_LWORD|DT_TO_SINT|DT_TO_INT|DT_TO_DINT|DT_TO_LINT|DT_TO_USINT|DT_TO_UINT|DT_TO_UDINT|DT_TO_ULINT|DT_TO_REAL|DT_TO_LREAL|DT_TO_STRING|DT_TO_WSTRING|DT_TO_TIME|DT_TO_DATE|DT_TO_TOD|STRING_TO_BOOL|STRING_TO_BYTE|STRING_TO_WORD|STRING_TO_DWORD|STRING_TO_LWORD|STRING_TO_SINT|STRING_TO_INT|STRING_TO_DINT|STRING_TO_LINT|STRING_TO_USINT|STRING_TO_UINT|STRING_TO_UDINT|STRING_TO_ULINT|STRING_TO_REAL|STRING_TO_LREAL|STRING_TO_TIME|STRING_TO_DATE|STRING_TO_TOD|STRING_TO_DT|WSTRING_TO_BOOL|WSTRING_TO_BYTE|WSTRING_TO_WORD|WSTRING_TO_DWORD|WSTRING_TO_LWORD|WSTRING_TO_SINT|WSTRING_TO_INT|WSTRING_TO_DINT|WSTRING_TO_LINT|WSTRING_TO_USINT|WSTRING_TO_UINT|WSTRING_TO_UDINT|WSTRING_TO_ULINT|WSTRING_TO_REAL|WSTRING_TO_LREAL|WSTRING_TO_TIME|WSTRING_TO_DATE|WSTRING_TO_TOD|WSTRING_TO_DT|TRUNC|BCD_TO_INT|INT_TO_BCD|TO_[A-Z][A-Z0-9_]*)\\b",
                    "name": "keyword.operator.type-cast.iec-st"
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "match": "\\b(BIT|BOOL|BYTE|WORD|DWORD|LWORD|SINT|INT|DINT|LINT|USINT|UINT|UDINT|ULINT|XINT|UXINT|XWORD|__XINT|__UXINT|__XWORD|REAL|LREAL|TIME|LTIME|DATE|LDATE|TIME_OF_DAY|TOD|LTIME_OF_DAY|LTOD|DATE_AND_TIME|DT|LDATE_AND_TIME|LDT|STRING|WSTRING|PVOID|ANY|ANY_DERIVED|ANY_ELEMENTARY|ANY_MAGNITUDE|ANY_NUM|ANY_REAL|ANY_INT|ANY_UNSIGNED|ANY_SIGNED|ANY_DURATION|ANY_BIT|ANY_CHARS|ANY_STRING|ANY_CHAR|ANY_DATE|ARRAY|OF|STRUCT|END_STRUCT|UNION|END_UNION)\\b",
                    "name": "storage.type.iec-st"
                },
                {
                    "match": "\\b(REF_TO|POINTER|REFERENCE|POINTER TO|REFERENCE TO)\\b",
                    "name": "storage.type.reference.iec-st"
                }
            ]
        },
        "constants": {
            "patterns": [
                {
                    "match": "\\b(TRUE|FALSE|NULL)\\b",
                    "name": "constant.language.iec-st"
                }
            ]
        },
        "variables": {
            "patterns": [
                {
                    "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b",
                    "name": "variable.other.iec-st"
                }
            ]
        }
    }
}
