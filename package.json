{
  "name": "tcview",
  "displayName": "TcView",
  "description": "Windows-first VS Code extension for viewing and editing TwinCAT PLC source as IEC Structured Text.",
  "version": "1.0.0-alpha.3",
  "publisher": "CodePiercerTechnology",
  "homepage": "https://github.com/CodePiercerTechnology/TcView#readme",
  "bugs": {
    "url": "https://github.com/CodePiercerTechnology/TcView/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/CodePiercerTechnology/TcView.git"
  },
  "os": [
    "win32"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onFileSystem:twincat",
    "onView:twincat.files",
    "onLanguage:iec-st",
    "onCommand:tcview.refreshFiles",
    "onCommand:tcview.openFile",
    "onCommand:tcview.openLibraryReference",
    "onCommand:tcview.openFromExplorer",
    "onCommand:tcview.openSolution",
    "onCommand:tcview.switchToXml",
    "onCommand:tcview.validateSyntax",
    "onCommand:tcview.showIndexStats",
    "onCommand:tcview.checkLspStatus",
    "onCommand:tcview.showPerfStats",
    "onCommand:tcview.exportPerfBaseline",
    "onCommand:tcview.exportPerfTrace",
    "onCommand:tcview.buildSolutionWithMsBuild",
    "onCommand:tcview.showLibraries",
    "onCommand:tcview.createLibraryMetadataTemplate",
    "onCommand:tcview.importLibraryProjectMetadata",
    "onCommand:tcview.removeLibraryMetadata",
    "onCommand:tcview.pruneUnusedLibraryMetadata",
    "onCommand:tcview.createTwinCATFile",
    "onCommand:tcview.createTwinCATFolder",
    "onCommand:tcview.renameTwinCATItem",
    "onCommand:tcview.deleteTwinCATFile",
    "onCommand:tcview.deleteTwinCATFolder",
    "onCommand:tcview.deleteTwinCATMember",
    "onCommand:tcview.copyTwinCATItem",
    "onCommand:tcview.cutTwinCATItem",
    "onCommand:tcview.pasteTwinCATItem",
    "onCommand:tcview.createTwinCATMethod",
    "onCommand:tcview.createTwinCATProperty",
    "onCommand:tcview.createTwinCATAction",
    "onCommand:tcview.createTwinCATTransition",
    "onCommand:tcview.addLibraryReference",
    "onCommand:tcview.removeLibraryReference"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "twincat",
          "title": "TcView",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "twincat": [
        {
          "id": "twincat.files",
          "name": "Explorer",
          "type": "webview",
          "icon": "$(symbol-structure)"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "twincat.files",
        "contents": "No folder is open.\n[Open TwinCAT Solution](command:tcview.openSolution)",
        "when": "workspaceFolderCount == 0 && tcview.discoveryComplete"
      },
      {
        "view": "twincat.files",
        "contents": "No TwinCAT solution was found in this folder.\n[Open TwinCAT Solution](command:tcview.openSolution)",
        "when": "workspaceFolderCount != 0 && tcview.discoveryComplete && !tcview.hasTwinCATFiles && !tcview.isLookingForTwinCAT"
      }
    ],
    "commands": [
      {
        "command": "tcview.refreshFiles",
        "title": "Refresh TcView Files",
        "icon": "$(refresh)"
      },
      {
        "command": "tcview.openFile",
        "title": "Open in TcView"
      },
      {
        "command": "tcview.openLibraryReference",
        "title": "Open TwinCAT Library Reference",
        "icon": "$(library)"
      },
      {
        "command": "tcview.openFromExplorer",
        "title": "Open in TcView",
        "icon": "$(file-code)"
      },
      {
        "command": "tcview.openSolution",
        "title": "Open TwinCAT Solution",
        "icon": "$(folder-opened)"
      },
      {
        "command": "tcview.switchToXml",
        "title": "Switch TcView View",
        "icon": "$(file-code)"
      },
      {
        "command": "tcview.validateSyntax",
        "title": "Validate TcView ST Syntax",
        "icon": "$(check)"
      },
      {
        "command": "tcview.showIndexStats",
        "title": "Show TcView Index Statistics",
        "icon": "$(graph)"
      },
      {
        "command": "tcview.checkLspStatus",
        "title": "Check TcView Language Status",
        "icon": "$(pulse)"
      },
      {
        "command": "tcview.showPerfStats",
        "title": "Show TcView Performance Stats",
        "icon": "$(dashboard)"
      },
      {
        "command": "tcview.exportPerfBaseline",
        "title": "Export TcView Performance Baseline",
        "icon": "$(export)"
      },
      {
        "command": "tcview.exportPerfTrace",
        "title": "Export TcView Performance Trace",
        "icon": "$(pulse)"
      },
      {
        "command": "tcview.buildSolutionWithMsBuild",
        "title": "Build TwinCAT Solution",
        "icon": "$(project)"
      },
      {
        "command": "tcview.showLibraries",
        "title": "Show TcView Libraries",
        "icon": "$(library)"
      },
      {
        "command": "tcview.createLibraryMetadataTemplate",
        "title": "Create TcView Global Library Metadata File",
        "icon": "$(new-file)"
      },
      {
        "command": "tcview.importLibraryProjectMetadata",
        "title": "Import TwinCAT Library Project Metadata",
        "icon": "$(repo-pull)"
      },
      {
        "command": "tcview.removeLibraryMetadata",
        "title": "Remove TwinCAT Library Metadata",
        "icon": "$(trash)"
      },
      {
        "command": "tcview.pruneUnusedLibraryMetadata",
        "title": "Prune Unused TwinCAT Library Metadata",
        "icon": "$(clear-all)"
      },
      {
        "command": "tcview.createTwinCATFile",
        "title": "New File...",
        "icon": "$(new-file)"
      },
      {
        "command": "tcview.createTwinCATFileFromTemplate",
        "title": "Create TwinCAT File From Template"
      },
      {
        "command": "tcview.createTwinCATFolder",
        "title": "New Folder...",
        "icon": "$(new-folder)"
      },
      {
        "command": "tcview.renameTwinCATItem",
        "title": "Rename",
        "icon": "$(edit)"
      },
      {
        "command": "tcview.deleteTwinCATFile",
        "title": "Delete",
        "icon": "$(trash)"
      },
      {
        "command": "tcview.deleteTwinCATFolder",
        "title": "Delete",
        "icon": "$(trash)"
      },
      {
        "command": "tcview.deleteTwinCATMember",
        "title": "Delete",
        "icon": "$(trash)"
      },
      {
        "command": "tcview.copyTwinCATItem",
        "title": "Copy",
        "icon": "$(copy)"
      },
      {
        "command": "tcview.cutTwinCATItem",
        "title": "Cut",
        "icon": "$(cut)"
      },
      {
        "command": "tcview.pasteTwinCATItem",
        "title": "Paste",
        "icon": "$(clippy)"
      },
      {
        "command": "tcview.createTwinCATMethod",
        "title": "Add Method...",
        "icon": "$(symbol-method)"
      },
      {
        "command": "tcview.createTwinCATProperty",
        "title": "Add Property...",
        "icon": "$(symbol-property)"
      },
      {
        "command": "tcview.createTwinCATAction",
        "title": "Add Action...",
        "icon": "$(symbol-event)"
      },
      {
        "command": "tcview.createTwinCATTransition",
        "title": "Add Transition...",
        "icon": "$(symbol-interface)"
      },
      {
        "command": "tcview.webExplorerStartRename",
        "title": "Rename"
      },
      {
        "command": "tcview.webExplorerStartCreateFolder",
        "title": "New Folder..."
      },
      {
        "command": "tcview.webExplorerAddFunctionBlock",
        "title": "Add Function Block..."
      },
      {
        "command": "tcview.webExplorerAddFunction",
        "title": "Add Function..."
      },
      {
        "command": "tcview.webExplorerAddProgram",
        "title": "Add Program..."
      },
      {
        "command": "tcview.webExplorerAddGvl",
        "title": "Add Global Variable List..."
      },
      {
        "command": "tcview.webExplorerAddDut",
        "title": "Add Data Type (STRUCT)..."
      },
      {
        "command": "tcview.webExplorerAddInterface",
        "title": "Add Interface..."
      },
      {
        "command": "tcview.deleteSelectedWebExplorerItem",
        "title": "Delete"
      },
      {
        "command": "tcview.addLibraryReference",
        "title": "Add TwinCAT Library To Project",
        "icon": "$(add)"
      },
      {
        "command": "tcview.removeLibraryReference",
        "title": "Remove TwinCAT Library From Project",
        "icon": "$(remove-close)"
      }
    ],
    "configuration": {
      "title": "TcView",
      "properties": {
        "twincat.performanceLogging": {
          "type": "boolean",
          "default": false,
          "description": "Enable performance timing logs for TcView open/scan operations."
        },
        "twincat.performanceTraceThresholdMs": {
          "type": "number",
          "default": 250,
          "minimum": 1,
          "description": "Threshold in milliseconds for recording slow runtime trace events in open/reindex/tree/save metric families."
        },
        "twincat.showSaveNotification": {
          "type": "boolean",
          "default": false,
          "description": "Show a confirmation notification after saving ST changes back to the source XML."
        },
        "twincat.build.msbuildPath": {
          "type": "string",
          "default": "",
          "description": "Optional absolute path to MSBuild.exe. When set, TcView uses this before auto-discovery."
        },
        "twincat.build.suppressUnsupportedTsprojWarning": {
          "type": "boolean",
          "default": true,
          "description": "Suppress MSBuild warning MSB4078 for unsupported TwinCAT .tsproj entries when building solutions."
        },
        "twincat.build.msbuildNoWarn": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Additional MSBuild warning codes to suppress via /nowarn (for example: [\"MSB4011\"])."
        },
        "twincat.backend.tmcRoots": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Root folders to search for TwinCAT .tmc files used as compiled symbol/type context (ai > tmc > source > metadata)."
        },
        "twincat.backend.executablePath": {
          "type": "string",
          "default": "",
          "description": "Optional absolute path to the TcView backend executable (.exe or .dll) used for TwinCAT Automation Interface operations such as library install/add/remove."
        },
        "twincat.library.managedRoots": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Additional TwinCAT Managed Libraries roots to scan for installed library metadata such as vendor, version, install path, and dependencies."
        },
        "twincat.library.metadataFiles": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Additional JSON files that extend TcView's built-in library metadata catalog. Relative paths resolve from the workspace/project root."
        },
        "twincat.library.showProjectImportWarning": {
          "type": "boolean",
          "default": true,
          "description": "Show a warning before importing metadata from a TwinCAT library project source. The import captures editor metadata only and does not install or update the actual TwinCAT library."
        },
        "twincat.diagnostics.profile": {
          "type": "string",
          "enum": [
            "balanced",
            "strict",
            "relaxed"
          ],
          "default": "balanced",
          "description": "Preset severity profile for diagnostics. balanced uses per-rule settings; strict and relaxed override them."
        },
        "twincat.keywordCasing": {
          "type": "string",
          "enum": [
            "upper",
            "lower",
            "preserve"
          ],
          "default": "upper",
          "description": "Keyword casing used by the IEC ST formatter."
        },
        "twincat.renameIncludeCommentsStrings": {
          "type": "boolean",
          "default": false,
          "description": "If true, rename/references include matches inside comments and string literals."
        },
        "twincat.createMissingVariableDefaultSection": {
          "type": "string",
          "enum": [
            "VAR",
            "VAR_INPUT",
            "VAR_OUTPUT",
            "VAR_IN_OUT",
            "VAR_TEMP"
          ],
          "default": "VAR",
          "description": "Default declaration section used by quick-fix: Declare missing variable."
        },
        "twincat.diagnostics.undefinedVariables": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "information",
            "hint"
          ],
          "default": "error",
          "description": "Severity for undefined variable diagnostics."
        },
        "twincat.diagnostics.unusedVariables": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "information",
            "hint"
          ],
          "default": "warning",
          "description": "Severity for unused variable diagnostics."
        },
        "twincat.diagnostics.duplicateDeclarations": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "information",
            "hint"
          ],
          "default": "error",
          "description": "Severity for duplicate declaration diagnostics."
        },
        "twincat.diagnostics.typeMismatch": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "information",
            "hint"
          ],
          "default": "error",
          "description": "Severity for simple assignment type mismatch diagnostics."
        }
      }
    },
    "configurationDefaults": {
      "files.associations": {
        "*.TcPOU": "xml",
        "*.TcGVL": "xml",
        "*.TcDUT": "xml",
        "*.TcPRG": "xml",
        "*.TcAPP": "xml",
        "*.TcCOM": "xml",
        "*.TcVAR": "xml",
        "*.TcGDS": "xml",
        "*.TcIO": "xml",
        "*.TcITF": "xml",
        "*.tcpou": "xml",
        "*.tcgvl": "xml",
        "*.tcdut": "xml",
        "*.tcprg": "xml",
        "*.tcapp": "xml",
        "*.tccom": "xml",
        "*.tcvar": "xml",
        "*.tcgds": "xml",
        "*.tcio": "xml",
        "*.tcitf": "xml",
        "*.plcproj": "xml",
        "*.tsproj": "xml",
        "*.tspproj": "xml",
        "*.tmc": "xml"
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "tcview.refreshFiles",
          "when": "view == twincat.files",
          "group": "navigation"
        },
        {
          "command": "tcview.openSolution",
          "when": "view == twincat.files",
          "group": "navigation@1"
        },
        {
          "command": "tcview.buildSolutionWithMsBuild",
          "when": "view == twincat.files && tcview.hasSolution",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
      ],
      "explorer/context": [
        {
          "command": "tcview.openFromExplorer",
          "when": "resourceExtname == .TcPOU || resourceExtname == .TcGVL || resourceExtname == .TcDUT || resourceExtname == .TcPRG || resourceExtname == .TcAPP || resourceExtname == .TcCOM || resourceExtname == .TcVAR || resourceExtname == .TcGDS || resourceExtname == .TcIO || resourceExtname == .TcITF || resourceExtname == .tcpou || resourceExtname == .tcgvl || resourceExtname == .tcdut || resourceExtname == .tcprg || resourceExtname == .tcapp || resourceExtname == .tccom || resourceExtname == .tcvar || resourceExtname == .tcgds || resourceExtname == .tcio || resourceExtname == .tcitf",
          "group": "navigation@1"
        },
        {
          "command": "tcview.buildSolutionWithMsBuild",
          "when": "tcview.hasSolution && (explorerResourceIsFolder || resourceExtname == .sln)",
          "group": "navigation@2"
        },
        {
          "command": "tcview.importLibraryProjectMetadata",
          "when": "explorerResourceIsFolder || resourceExtname == .plcproj",
          "group": "navigation@3"
        },
        {
          "command": "tcview.removeLibraryMetadata",
          "when": "explorerResourceIsFolder || resourceExtname == .plcproj",
          "group": "navigation@4"
        },
        {
          "command": "tcview.pruneUnusedLibraryMetadata",
          "when": "explorerResourceIsFolder || resourceExtname == .plcproj",
          "group": "navigation@4.5"
        }
      ],
      "editor/title": [
        {
          "command": "tcview.switchToXml",
          "when": "resourceScheme == twincat || (resourceScheme == file && (resourceExtname == .TcPOU || resourceExtname == .TcGVL || resourceExtname == .TcDUT || resourceExtname == .TcPRG || resourceExtname == .TcAPP || resourceExtname == .TcCOM || resourceExtname == .TcVAR || resourceExtname == .TcGDS || resourceExtname == .TcIO || resourceExtname == .TcITF || resourceExtname == .tcpou || resourceExtname == .tcgvl || resourceExtname == .tcdut || resourceExtname == .tcprg || resourceExtname == .tcapp || resourceExtname == .tccom || resourceExtname == .tcvar || resourceExtname == .tcgds || resourceExtname == .tcio || resourceExtname == .tcitf))",
          "group": "navigation@2"
        }
      ],
      "webview/context": [
        {
          "command": "tcview.webExplorerAddFunctionBlock",
          "when": "webviewId == twincat.files && webviewSection == tcview.node && (tcviewItemType == plcProjectFolder || tcviewItemType == folder)",
          "group": "1_add@1"
        },
        {
          "command": "tcview.webExplorerAddFunction",
          "when": "webviewId == twincat.files && webviewSection == tcview.node && (tcviewItemType == plcProjectFolder || tcviewItemType == folder)",
          "group": "1_add@2"
        },
        {
          "command": "tcview.webExplorerAddProgram",
          "when": "webviewId == twincat.files && webviewSection == tcview.node && (tcviewItemType == plcProjectFolder || tcviewItemType == folder)",
          "group": "1_add@3"
        },
        {
          "command": "tcview.webExplorerAddGvl",
          "when": "webviewId == twincat.files && webviewSection == tcview.node && (tcviewItemType == plcProjectFolder || tcviewItemType == folder)",
          "group": "1_add@4"
        },
        {
          "command": "tcview.webExplorerAddDut",
          "when": "webviewId == twincat.files && webviewSection == tcview.node && (tcviewItemType == plcProjectFolder || tcviewItemType == folder)",
          "group": "1_add@5"
        },
        {
          "command": "tcview.webExplorerAddInterface",
          "when": "webviewId == twincat.files && webviewSection == tcview.node && (tcviewItemType == plcProjectFolder || tcviewItemType == folder)",
          "group": "1_add@6"
        },
        {
          "command": "tcview.webExplorerStartCreateFolder",
          "when": "webviewId == twincat.files && webviewSection == tcview.node && (tcviewItemType == plcProjectFolder || tcviewItemType == folder || (tcviewItemType == pouFolder && (tcviewFileKind == functionBlock || tcviewFileKind == program || tcviewFileKind == interface || tcviewFileKind == gvl)) || ((tcviewItemType == file) && (tcviewFileKind == functionBlock || tcviewFileKind == program || tcviewFileKind == interface || tcviewFileKind == gvl)))",
          "group": "1_add@7"
        },
        {
          "command": "tcview.createTwinCATMethod",
          "when": "webviewId == twincat.files && webviewSection == tcview.node && (tcviewItemType == file || tcviewItemType == pouFolder) && (tcviewFileKind == functionBlock || tcviewFileKind == program || tcviewFileKind == interface)",
          "group": "1_add@8"
        },
        {
          "command": "tcview.createTwinCATProperty",
          "when": "webviewId == twincat.files && webviewSection == tcview.node && (tcviewItemType == file || tcviewItemType == pouFolder) && (tcviewFileKind == functionBlock || tcviewFileKind == program || tcviewFileKind == interface || tcviewFileKind == gvl)",
          "group": "1_add@9"
        },
        {
          "command": "tcview.createTwinCATAction",
          "when": "webviewId == twincat.files && webviewSection == tcview.node && (tcviewItemType == file || tcviewItemType == pouFolder) && (tcviewFileKind == functionBlock || tcviewFileKind == program)",
          "group": "1_add@10"
        },
        {
          "command": "tcview.createTwinCATTransition",
          "when": "webviewId == twincat.files && webviewSection == tcview.node && (tcviewItemType == file || tcviewItemType == pouFolder) && (tcviewFileKind == functionBlock || tcviewFileKind == program)",
          "group": "1_add@11"
        },
        {
          "command": "tcview.webExplorerStartRename",
          "when": "webviewId == twincat.files && webviewSection == tcview.node && (tcviewItemType == folder || tcviewItemType == file || tcviewItemType == pouFolder || tcviewItemType == method || tcviewItemType == property || tcviewItemType == action || tcviewItemType == transition)",
          "group": "2_edit@1"
        },
        {
          "command": "tcview.copyTwinCATItem",
          "when": "webviewId == twincat.files && webviewSection == tcview.node && (tcviewItemType == folder || tcviewItemType == file || tcviewItemType == pouFolder || tcviewItemType == method || tcviewItemType == property || tcviewItemType == action || tcviewItemType == transition)",
          "group": "2_edit@2"
        },
        {
          "command": "tcview.cutTwinCATItem",
          "when": "webviewId == twincat.files && webviewSection == tcview.node && (tcviewItemType == folder || tcviewItemType == file || tcviewItemType == pouFolder || tcviewItemType == method || tcviewItemType == property || tcviewItemType == action || tcviewItemType == transition)",
          "group": "2_edit@3"
        },
        {
          "command": "tcview.pasteTwinCATItem",
          "when": "webviewId == twincat.files && webviewSection == tcview.node && (tcviewItemType == plcProjectFolder || tcviewItemType == folder || tcviewItemType == file || tcviewItemType == pouFolder || tcviewItemType == method || tcviewItemType == property || tcviewItemType == action || tcviewItemType == transition)",
          "group": "2_edit@4"
        },
        {
          "command": "tcview.deleteSelectedWebExplorerItem",
          "when": "webviewId == twincat.files && webviewSection == tcview.node && (tcviewItemType == file || tcviewItemType == folder || tcviewItemType == pouFolder || tcviewItemType == method || tcviewItemType == property || tcviewItemType == propertyGet || tcviewItemType == propertySet || tcviewItemType == action || tcviewItemType == transition)",
          "group": "3_delete@1"
        },
        {
          "command": "tcview.importLibraryProjectMetadata",
          "when": "webviewId == twincat.files && webviewSection == tcview.node && tcviewItemType == plcProjectFolder",
          "group": "4_library@1"
        },
        {
          "command": "tcview.removeLibraryMetadata",
          "when": "webviewId == twincat.files && webviewSection == tcview.node && (tcviewItemType == plcProjectFolder || tcviewItemType == referenceItem)",
          "group": "4_library@2"
        },
        {
          "command": "tcview.pruneUnusedLibraryMetadata",
          "when": "webviewId == twincat.files && webviewSection == tcview.node && (tcviewItemType == plcProjectFolder || tcviewItemType == referencesRoot)",
          "group": "4_library@3"
        },
        {
          "command": "tcview.addLibraryReference",
          "when": "webviewId == twincat.files && webviewSection == tcview.node && tcview.hasSolution && tcviewItemType == referencesRoot",
          "group": "4_library@4"
        },
        {
          "command": "tcview.removeLibraryReference",
          "when": "webviewId == twincat.files && webviewSection == tcview.node && tcview.hasSolution && tcviewItemType == referenceItem",
          "group": "4_library@5"
        },
        {
          "command": "tcview.openLibraryReference",
          "when": "webviewId == twincat.files && webviewSection == tcview.node && tcviewItemType == referenceItem",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "tcview.deleteSelectedWebExplorerItem",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "tcview.webExplorerStartRename",
        "key": "f2",
        "when": "tcview.webExplorerFocus && !inputFocus"
      },
      {
        "command": "tcview.deleteSelectedWebExplorerItem",
        "key": "delete",
        "when": "tcview.webExplorerFocus && !inputFocus"
      },
      {
        "command": "tcview.copyTwinCATItem",
        "key": "ctrl+c",
        "mac": "cmd+c",
        "when": "tcview.webExplorerFocus && !inputFocus"
      },
      {
        "command": "tcview.cutTwinCATItem",
        "key": "ctrl+x",
        "mac": "cmd+x",
        "when": "tcview.webExplorerFocus && !inputFocus"
      },
      {
        "command": "tcview.pasteTwinCATItem",
        "key": "ctrl+v",
        "mac": "cmd+v",
        "when": "tcview.webExplorerFocus && !inputFocus"
      }
    ],
